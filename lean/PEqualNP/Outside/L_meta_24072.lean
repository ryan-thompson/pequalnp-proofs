  refine ⟨{ gates := [{ op := PEqualNP.CircuitLowerBounds.GateOp.and, inputs := [3, 2] }, { op := PEqualNP.CircuitLowerBounds.GateOp.or, inputs := [5, 4] }, { op := PEqualNP.CircuitLowerBounds.GateOp.or, inputs := [6, 1] }, { op := PEqualNP.CircuitLowerBounds.GateOp.not, inputs := [7] }, { op := PEqualNP.CircuitLowerBounds.GateOp.or, inputs := [1, 0] }, { op := PEqualNP.CircuitLowerBounds.GateOp.or, inputs := [6, 2] }, { op := PEqualNP.CircuitLowerBounds.GateOp.and, inputs := [9, 10] }, { op := PEqualNP.CircuitLowerBounds.GateOp.or, inputs := [11, 8] }], output := 12 }, ?_, by decide, ?_⟩
  · intro g hg
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hg
    rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp
  · decide +kernel
